# Copy to project root .env before docker compose up.
# Generate with: openssl rand -hex 32 (hex avoids URL escaping in DATABASE_URL).
POSTGRES_PASSWORD=
API_PORT=3000
CORS_ORIGINS=https://localhost,http://localhost,http://localhost:5173
REGISTRATION_ENABLED=true
# Optional invite code for private testing; empty permits self-registration.
REGISTRATION_INVITE_CODE=
SESSION_DAYS=30
# For --profile https only, set a domain whose DNS points to your server.
APP_DOMAIN=api.example.com
